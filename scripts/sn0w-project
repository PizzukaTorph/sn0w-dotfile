#!/usr/bin/env python3
import argparse
import json
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    print("sn0w-project: python3-pyyaml is required", file=sys.stderr)
    raise SystemExit(2)

STATE_DIR = Path.home() / ".local/state/sn0w/projects"
LAUNCH_GRACE_SECONDS = 15


def run(cmd, cwd=None, check=False, quiet=False):
    kwargs = {"cwd": cwd, "text": True}
    if quiet:
        kwargs.update(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return subprocess.run(cmd, check=check, **kwargs)


def output(cmd, cwd=None):
    try:
        return subprocess.check_output(cmd, cwd=cwd, text=True, stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def spawn(cmd, cwd=None):
    subprocess.Popen(cmd, cwd=cwd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def slug(value):
    return re.sub(r"[^a-zA-Z0-9._-]+", "-", value).strip("-").lower() or "project"


def load_project(path):
    root = Path(path).expanduser().resolve()
    cfg_path = root / ".sn0w/project.yaml"
    data = {}
    if cfg_path.exists():
        data = yaml.safe_load(cfg_path.read_text()) or {}
        if not isinstance(data, dict):
            raise ValueError(".sn0w/project.yaml must contain a mapping")
    name = str(data.get("name") or root.name)
    data["name"] = name
    data["path"] = str(root)
    data["configured"] = cfg_path.exists()
    data["workspace"] = str(data.get("workspace") or f"project-{slug(name)}")
    return data


def state_path(project):
    return STATE_DIR / f"{slug(project['path'])}.json"


def read_state(project):
    path = state_path(project)
    if not path.exists():
        return None
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else None
    except (json.JSONDecodeError, OSError):
        return None


def write_state(project, running=True, phase=None):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    previous = read_state(project) or {}
    now = int(time.time())
    payload = {
        "name": project["name"],
        "path": project["path"],
        "workspace": project["workspace"],
        "running": running,
        "phase": phase or ("running" if running else "stopped"),
        "startedAt": previous.get("startedAt", now) if running else previous.get("startedAt", now),
        "updatedAt": now,
    }
    if running and not previous.get("running"):
        payload["startedAt"] = now
    state_path(project).write_text(json.dumps(payload, indent=2) + "\n")


def compose_args(project):
    compose = project.get("compose", True)
    if compose is False:
        return None
    if isinstance(compose, str):
        return ["docker", "compose", "-f", compose]
    if isinstance(compose, dict) and compose.get("file"):
        return ["docker", "compose", "-f", str(compose["file"])]
    root = Path(project["path"])
    if any((root / f).exists() for f in ("compose.yml", "compose.yaml", "docker-compose.yml", "docker-compose.yaml")):
        return ["docker", "compose"]
    return None


def require_compose(project):
    compose = compose_args(project)
    if not compose:
        print("sn0w-project: project has no Docker Compose configuration", file=sys.stderr)
        raise SystemExit(3)
    return compose


def terminal_args(value):
    parts = shlex.split(value or "foot")
    return parts or ["foot"]


def parse_hypr_json(raw):
    if not raw:
        return []
    index = raw.find("[")
    if index >= 0:
        raw = raw[index:]
    try:
        value = json.loads(raw)
        return value if isinstance(value, list) else []
    except json.JSONDecodeError:
        return []


def hypr_clients():
    return parse_hypr_json(output(["hyprctl", "-j", "clients"]))


def workspace_clients(project):
    name = project["workspace"]
    result = []
    for client in hypr_clients():
        workspace = client.get("workspace") or {}
        if str(workspace.get("name", "")) == name:
            result.append(client)
    return result


def focus_workspace(project):
    run(["hyprctl", "dispatch", "workspace", f"name:{project['workspace']}"], quiet=True)


def compose_services(project):
    root = project["path"]
    compose = compose_args(project)
    services = []
    if not compose:
        return services
    raw = output(compose + ["ps", "--format", "json"], cwd=root)
    if not raw:
        return services
    try:
        decoded = json.loads(raw)
        rows = decoded if isinstance(decoded, list) else [decoded]
    except json.JSONDecodeError:
        rows = []
        for line in raw.splitlines():
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    for row in rows:
        publishers = row.get("Publishers") or []
        ports = []
        if isinstance(publishers, list):
            for pub in publishers:
                if not isinstance(pub, dict):
                    continue
                published = pub.get("PublishedPort")
                target = pub.get("TargetPort")
                if published:
                    ports.append({
                        "published": int(published),
                        "target": int(target) if target else None,
                        "protocol": str(pub.get("Protocol") or "tcp"),
                    })
        state = str(row.get("State") or "")
        health = str(row.get("Health") or "")
        services.append({
            "name": row.get("Service") or row.get("Name", ""),
            "state": state,
            "health": health,
            "ready": state.lower() == "running" and health.lower() not in ("starting", "unhealthy"),
            "ports": ports,
        })
    return services


def project_status(project):
    root = project["path"]
    branch = output(["git", "-C", root, "branch", "--show-current"])
    dirty = bool(output(["git", "-C", root, "status", "--porcelain"]))
    services = compose_services(project)
    clients = workspace_clients(project)
    state = read_state(project)
    compose_running = any(str(s.get("state", "")).lower() == "running" for s in services)
    updated_at = int((state or {}).get("updatedAt", 0) or 0)
    launching = bool(state and state.get("running") and time.time() - updated_at < LAUNCH_GRACE_SECONDS)
    running = bool(clients) or compose_running or launching
    session = dict(state or {})
    session["running"] = running
    session["launching"] = launching and not (clients or compose_running)
    session["phase"] = "launching" if session["launching"] else ("running" if running else "stopped")
    session["windowCount"] = len(clients)
    session["serviceCount"] = len(services)
    session["readyServiceCount"] = sum(1 for service in services if service.get("ready"))
    return {**project, "branch": branch, "dirty": dirty, "services": services, "session": session}


def wait_for_services(project, timeout=12):
    if not compose_args(project):
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        services = compose_services(project)
        if services and all(service.get("ready") for service in services):
            return
        time.sleep(0.5)


def launch_project(project):
    root = project["path"]
    write_state(project, True, "launching")
    focus_workspace(project)
    compose = compose_args(project)
    if compose:
        result = run(compose + ["up", "-d"], cwd=root)
        if result.returncode != 0:
            write_state(project, False, "failed")
            raise SystemExit(result.returncode)
        wait_for_services(project)

    editor = project.get("editor", "code")
    if editor:
        if isinstance(editor, list):
            spawn([str(x) for x in editor], cwd=root)
        else:
            spawn([str(editor), root], cwd=root)

    for terminal in project.get("terminals", []):
        if isinstance(terminal, str):
            spawn(["foot", "-D", str(Path(root) / terminal)])
        elif isinstance(terminal, dict):
            cwd = str(Path(root) / str(terminal.get("cwd", ".")))
            command = terminal.get("command")
            if command:
                spawn(["foot", "-D", cwd, "sh", "-lc", str(command)])
            else:
                spawn(["foot", "-D", cwd])

    for url in project.get("links", project.get("urls", [])):
        target = url.get("url") if isinstance(url, dict) else url
        if target:
            spawn(["xdg-open", str(target)])

    write_state(project, True, "running")


def start(project, resume=False):
    status = project_status(project)
    if status["session"].get("running"):
        focus_workspace(project)
        write_state(project, True, "running")
    else:
        launch_project(project)
    print(json.dumps(project_status(project)))


def stop(project, keep_services=False):
    write_state(project, True, "stopping")
    compose = compose_args(project)
    if compose and not keep_services:
        run(compose + ["stop"], cwd=project["path"])
    for client in workspace_clients(project):
        address = str(client.get("address", ""))
        if address:
            run(["hyprctl", "dispatch", "closewindow", f"address:{address}"], quiet=True)
    write_state(project, False, "stopped")
    print(json.dumps(project_status(project)))


def doctor(project):
    compose = compose_args(project)
    editor = project.get("editor", "code")
    editor_bin = str(editor[0]) if isinstance(editor, list) and editor else str(editor or "")
    checks = {
        "pathExists": Path(project["path"]).is_dir(),
        "git": shutil.which("git") is not None,
        "hyprctl": shutil.which("hyprctl") is not None,
        "editor": not editor_bin or shutil.which(editor_bin) is not None,
        "docker": compose is None or shutil.which("docker") is not None,
        "composeConfigured": compose is not None,
        "configured": project.get("configured", False),
    }
    checks["ok"] = all(checks[key] for key in ("pathExists", "git", "hyprctl", "editor", "docker"))
    print(json.dumps({"project": project, "checks": checks}))


def service_logs(project, service, terminal):
    compose = require_compose(project)
    spawn(terminal_args(terminal) + ["-e"] + compose + ["logs", "-f", "--tail", "200", service], cwd=project["path"])


def service_exec(project, service, terminal):
    compose = require_compose(project)
    spawn(terminal_args(terminal) + ["-e"] + compose + ["exec", service, "sh"], cwd=project["path"])


def service_restart(project, service):
    compose = require_compose(project)
    result = run(compose + ["restart", service], cwd=project["path"])
    raise SystemExit(result.returncode)


def service_open(project, service):
    match = next((s for s in compose_services(project) if s.get("name") == service), None)
    if not match:
        print(f"sn0w-project: service not found: {service}", file=sys.stderr)
        raise SystemExit(4)
    ports = match.get("ports") or []
    if not ports:
        print(f"sn0w-project: service has no published ports: {service}", file=sys.stderr)
        raise SystemExit(5)
    port = ports[0].get("published")
    if not port:
        raise SystemExit(5)
    spawn(["xdg-open", f"http://127.0.0.1:{port}"])


def main():
    parser = argparse.ArgumentParser(prog="sn0w-project")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "start", "resume", "doctor"):
        command = sub.add_parser(name)
        command.add_argument("path")
    command = sub.add_parser("stop")
    command.add_argument("path")
    command.add_argument("--keep-services", action="store_true")
    command = sub.add_parser("init")
    command.add_argument("path", nargs="?", default=".")
    for name in ("service-logs", "service-exec"):
        command = sub.add_parser(name)
        command.add_argument("path")
        command.add_argument("service")
        command.add_argument("--terminal", default="foot")
    for name in ("service-restart", "service-open"):
        command = sub.add_parser(name)
        command.add_argument("path")
        command.add_argument("service")

    args = parser.parse_args()
    project = load_project(args.path)

    if args.command == "status":
        print(json.dumps(project_status(project)))
    elif args.command in ("start", "resume"):
        start(project, args.command == "resume")
    elif args.command == "stop":
        stop(project, args.keep_services)
    elif args.command == "doctor":
        doctor(project)
    elif args.command == "service-logs":
        service_logs(project, args.service, args.terminal)
    elif args.command == "service-exec":
        service_exec(project, args.service, args.terminal)
    elif args.command == "service-restart":
        service_restart(project, args.service)
    elif args.command == "service-open":
        service_open(project, args.service)
    elif args.command == "init":
        target = Path(project["path"]) / ".sn0w/project.yaml"
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            print(target)
            return
        target.write_text(
            f"name: {project['name']}\n"
            "# workspace: project-my-project\n"
            "# editor: code\n"
            "# compose: true\n"
            "# terminals:\n"
            "#   - cwd: .\n"
            "# links:\n"
            "#   - http://localhost:3000\n"
        )
        print(target)


if __name__ == "__main__":
    main()
