#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

try:
    import yaml
except ImportError:
    print("sn0w-project: python3-pyyaml is required", file=sys.stderr)
    raise SystemExit(2)

STATE_DIR = Path.home() / ".local/state/sn0w/projects"


def run(cmd, cwd=None, check=False, quiet=False):
    kwargs = {"cwd": cwd, "text": True}
    if quiet:
        kwargs.update(stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return subprocess.run(cmd, check=check, **kwargs)


def output(cmd, cwd=None):
    try:
        return subprocess.check_output(cmd, cwd=cwd, text=True, stderr=subprocess.DEVNULL).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return ""


def spawn(cmd, cwd=None):
    subprocess.Popen(cmd, cwd=cwd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def slug(value):
    return re.sub(r"[^a-zA-Z0-9._-]+", "-", value).strip("-").lower() or "project"


def load_project(path):
    root = Path(path).expanduser().resolve()
    cfg_path = root / ".sn0w/project.yaml"
    data = {}
    if cfg_path.exists():
        data = yaml.safe_load(cfg_path.read_text()) or {}
        if not isinstance(data, dict):
            raise ValueError(".sn0w/project.yaml must contain a mapping")
    name = str(data.get("name") or root.name)
    data["name"] = name
    data["path"] = str(root)
    data["configured"] = cfg_path.exists()
    data["workspace"] = str(data.get("workspace") or f"project-{slug(name)}")
    return data


def state_path(project):
    return STATE_DIR / f"{slug(project['path'])}.json"


def read_state(project):
    path = state_path(project)
    if not path.exists():
        return None
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else None
    except (json.JSONDecodeError, OSError):
        return None


def write_state(project, running=True):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    payload = {
        "name": project["name"],
        "path": project["path"],
        "workspace": project["workspace"],
        "running": running,
        "updatedAt": int(time.time()),
    }
    state_path(project).write_text(json.dumps(payload, indent=2) + "\n")


def compose_args(project):
    compose = project.get("compose", True)
    if compose is False:
        return None
    if isinstance(compose, str):
        return ["docker", "compose", "-f", compose]
    if isinstance(compose, dict) and compose.get("file"):
        return ["docker", "compose", "-f", str(compose["file"])]
    root = Path(project["path"])
    if any((root / f).exists() for f in ("compose.yml", "compose.yaml", "docker-compose.yml", "docker-compose.yaml")):
        return ["docker", "compose"]
    return None


def hypr_clients():
    raw = output(["hyprctl", "-j", "clients"])
    if not raw:
        return []
    try:
        value = json.loads(raw)
        return value if isinstance(value, list) else []
    except json.JSONDecodeError:
        return []


def workspace_clients(project):
    name = project["workspace"]
    result = []
    for client in hypr_clients():
        workspace = client.get("workspace") or {}
        if str(workspace.get("name", "")) == name:
            result.append(client)
    return result


def focus_workspace(project):
    run(["hyprctl", "dispatch", "workspace", f"name:{project['workspace']}"], quiet=True)


def project_status(project):
    root = project["path"]
    branch = output(["git", "-C", root, "branch", "--show-current"])
    dirty = bool(output(["git", "-C", root, "status", "--porcelain"]))
    compose = compose_args(project)
    services = []
    if compose:
        raw = output(compose + ["ps", "--format", "json"], cwd=root)
        if raw:
            try:
                decoded = json.loads(raw)
                rows = decoded if isinstance(decoded, list) else [decoded]
            except json.JSONDecodeError:
                rows = []
                for line in raw.splitlines():
                    try:
                        rows.append(json.loads(line))
                    except json.JSONDecodeError:
                        pass
            for row in rows:
                publishers = row.get("Publishers") or []
                ports = []
                if isinstance(publishers, list):
                    for pub in publishers:
                        if not isinstance(pub, dict):
                            continue
                        published = pub.get("PublishedPort")
                        target = pub.get("TargetPort")
                        if published:
                            ports.append(f"{published}:{target}" if target else str(published))
                services.append({
                    "name": row.get("Service") or row.get("Name", ""),
                    "state": row.get("State", ""),
                    "health": row.get("Health", ""),
                    "ports": ports,
                })
    clients = workspace_clients(project)
    state = read_state(project)
    compose_running = any(str(s.get("state", "")).lower() == "running" for s in services)
    running = bool(clients) or compose_running or bool(state and state.get("running"))
    session = dict(state or {})
    session["running"] = running
    session["windowCount"] = len(clients)
    return {**project, "branch": branch, "dirty": dirty, "services": services, "session": session}


def launch_project(project):
    root = project["path"]
    focus_workspace(project)
    compose = compose_args(project)
    if compose:
        run(compose + ["up", "-d"], cwd=root)
    editor = project.get("editor", "code")
    if editor:
        if isinstance(editor, list):
            spawn([str(x) for x in editor], cwd=root)
        else:
            spawn([str(editor), root], cwd=root)
    for terminal in project.get("terminals", []):
        if isinstance(terminal, str):
            spawn(["foot", "-D", str(Path(root) / terminal)])
        elif isinstance(terminal, dict):
            cwd = str(Path(root) / str(terminal.get("cwd", ".")))
            command = terminal.get("command")
            if command:
                spawn(["foot", "-D", cwd, "sh", "-lc", str(command)])
            else:
                spawn(["foot", "-D", cwd])
    for url in project.get("links", project.get("urls", [])):
        target = url.get("url") if isinstance(url, dict) else url
        if target:
            spawn(["xdg-open", str(target)])
    write_state(project, True)


def start(project, resume=False):
    status = project_status(project)
    if status["session"].get("running"):
        # Start is idempotent. Resume and repeated Start both focus the existing
        # project workspace instead of duplicating editor/browser/terminal windows.
        focus_workspace(project)
    else:
        launch_project(project)
    print(json.dumps(project_status(project)))


def stop(project, keep_services=False):
    compose = compose_args(project)
    if compose and not keep_services:
        run(compose + ["stop"], cwd=project["path"])
    # Hyprland's closewindow selector is window-oriented, not workspace-oriented.
    # Resolve the project's clients first and close them by address so another
    # workspace can never be touched accidentally.
    for client in workspace_clients(project):
        address = str(client.get("address", ""))
        if address:
            run(["hyprctl", "dispatch", "closewindow", f"address:{address}"], quiet=True)
    write_state(project, False)
    print(json.dumps(project_status(project)))


def main():
    parser = argparse.ArgumentParser(prog="sn0w-project")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "start", "resume"):
        p = sub.add_parser(name)
        p.add_argument("path")
    p = sub.add_parser("stop")
    p.add_argument("path")
    p.add_argument("--keep-services", action="store_true")
    p = sub.add_parser("init")
    p.add_argument("path", nargs="?", default=".")
    args = parser.parse_args()
    project = load_project(args.path)
    if args.command == "status":
        print(json.dumps(project_status(project)))
    elif args.command in ("start", "resume"):
        start(project, args.command == "resume")
    elif args.command == "stop":
        stop(project, args.keep_services)
    elif args.command == "init":
        target = Path(project["path"]) / ".sn0w/project.yaml"
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            print(target)
            return
        target.write_text(
            f"name: {project['name']}\n"
            "# workspace: project-my-project\n"
            "# editor: code\n"
            "# compose: true\n"
            "# terminals:\n"
            "#   - cwd: .\n"
            "# links:\n"
            "#   - http://localhost:3000\n"
        )
        print(target)


if __name__ == "__main__":
    main()
